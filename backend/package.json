{
	"name": "zumik-backend",
	"version": "1.0.0",
	"type": "module",
	"description": "Zumik backend with Supabase, Express, and Socket.io",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:tunnel": "sh scripts/start-with-tunnel.sh",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"start": "node dist/server.js",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:int": "vitest run --config vitest.int.config.ts",
		"format": "prettier --write \"**/*.{ts,json,md}\"",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"check": "node ../tools/guardrails/run-checks.mjs type-check check:lint check:dead-code check:deps check:duplication check:semgrep check:ast-grep check:secrets test check:exceptions",
		"check:lint": "eslint . --quiet",
		"check:dead-code": "knip",
		"check:deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known --output-type err-long",
		"check:duplication": "jscpd",
		"check:semgrep": "node ../tools/guardrails/docker-scan.mjs semgrep backend",
		"check:ast-grep": "ast-grep scan",
		"check:secrets": "node ../tools/guardrails/docker-scan.mjs secrets backend",
		"check:exceptions": "node ../tools/guardrails/check-exceptions.mjs backend",
		"swagger:export": "curl http://localhost:3000/api-docs.json -o openapi.json && echo 'Exported to openapi.json'",
		"swagger:validate": "npx @apidevtools/swagger-cli validate openapi.json",
		"swagger:serve": "npx @redocly/cli preview-docs openapi.json",
		"prepare": "cd .. && husky"
	},
	"keywords": [
		"zumik",
		"music",
		"collaboration",
		"supabase",
		"socket.io",
		"express"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@supabase/supabase-js": "^2.88.0",
		"@types/nodemailer": "^7.0.4",
		"cors": "^2.8.5",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.2.1",
		"google-auth-library": "^10.5.0",
		"ioredis": "^5.8.2",
		"multer": "^2.4.0",
		"nodemailer": "^7.0.12",
		"proxy-addr": "^2.0.8",
		"rate-limit-redis": "^4.3.1",
		"socket.io": "^4.8.1",
		"soundcloud.ts": "^0.7.1",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.51.0",
		"@eslint/js": "^9.39.2",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/multer": "^2.3.0",
		"@types/node": "^22.10.5",
		"@types/proxy-addr": "^2.0.3",
		"@types/swagger-ui-express": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.11",
		"dependency-cruiser": "^18.7.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"jscpd": "^5.4.2",
		"knip": "^5.88.1",
		"prettier": "^3.6.2",
		"socket.io-client": "^4.8.4",
		"supabase": "^2.119.0",
		"tsc-alias": "^1.8.10",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.50.1",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"node-domexception": "npm:domexception@^4.0.0",
		"qs": "^6.14.1"
	}
}
