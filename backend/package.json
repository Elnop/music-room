{
  "name": "zumik-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Zumik backend with Supabase, Express, and Socket.io",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:tunnel": "sh start-with-tunnel.sh",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "swagger:export": "curl http://localhost:3000/api-docs.json -o openapi.json && echo 'Exported to openapi.json'",
    "swagger:validate": "npx @apidevtools/swagger-cli validate openapi.json",
    "swagger:serve": "npx @redocly/cli preview-docs openapi.json"
  },
  "keywords": [
    "music",
    "room",
    "supabase",
    "socket.io",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.8.2",
    "openapi-types": "^12.1.3",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.1",
    "soundcloud.ts": "^0.7.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.10.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.0",
    "supabase": "^1.200.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.50.1"
  },
  "overrides": {
    "node-domexception": "npm:domexception@^4.0.0"
  }
}
