{
	"name": "zumik-backend",
	"version": "1.0.0",
	"type": "module",
	"description": "Zumik backend with Supabase, Express, and Socket.io",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:tunnel": "sh scripts/start-with-tunnel.sh",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"start": "node dist/server.js",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:int": "vitest run --config vitest.int.config.ts",
		"format": "prettier --write \"**/*.{ts,json,md}\"",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"swagger:export": "curl http://localhost:3000/api-docs.json -o openapi.json && echo 'Exported to openapi.json'",
		"swagger:validate": "npx @apidevtools/swagger-cli validate openapi.json",
		"swagger:serve": "npx @redocly/cli preview-docs openapi.json"
	},
	"keywords": [
		"zumik",
		"music",
		"collaboration",
		"supabase",
		"socket.io",
		"express"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@supabase/supabase-js": "^2.88.0",
		"@types/nodemailer": "^7.0.4",
		"cors": "^2.8.5",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.2.1",
		"google-auth-library": "^10.5.0",
		"ioredis": "^5.8.2",
		"multer": "^2.4.0",
		"nodemailer": "^7.0.12",
		"openapi-types": "^12.1.3",
		"proxy-addr": "^2.0.8",
		"rate-limit-redis": "^4.3.1",
		"socket.io": "^4.8.1",
		"soundcloud.ts": "^0.7.1",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/ioredis": "^4.28.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^22.10.5",
		"@types/proxy-addr": "^2.0.3",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^8.50.1",
		"@typescript-eslint/parser": "^8.50.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.2.0",
		"prettier": "^3.6.2",
		"socket.io-client": "^4.8.4",
		"supabase": "^2.119.0",
		"tsc-alias": "^1.8.10",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.50.1",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"node-domexception": "npm:domexception@^4.0.0",
		"qs": "^6.14.1"
	}
}
