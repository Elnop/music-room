# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase Project ID (Required for type generation)
# Find it in your dashboard URL: https://supabase.com/dashboard/project/YOUR_PROJECT_ID
# Used by: npm run generate-types
# Note: You must login first with: npx supabase login
#       Get token from: https://supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_ID=your-project-id

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# ngrok Configuration (Required for Tunnel Mode)
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
# Sign up (free): https://dashboard.ngrok.com/signup
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# Tunnel Mode (Auto-configured - DO NOT SET MANUALLY)
# TUNNEL_URL is automatically set by start-with-tunnel.sh when running in tunnel mode
# Example: TUNNEL_URL=https://abc123.ngrok-free.app
# Leave empty for LAN mode

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# =====================================================
# Redis Configuration (Rate Limiting & Brute Force Protection)
# =====================================================

# Redis connection (Docker mode: "redis" | Local mode: "localhost")
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true

# Login Rate Limits
RATE_LIMIT_LOGIN_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_LOGIN_MAX=5               # 5 attempts per window

# Registration Rate Limits
RATE_LIMIT_REGISTER_WINDOW_MS=3600000  # 1 hour
RATE_LIMIT_REGISTER_MAX=3              # 3 registrations per hour per IP

# OAuth Rate Limits
RATE_LIMIT_OAUTH_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_OAUTH_MAX=10              # 10 attempts per provider

# Global Auth Rate Limits
RATE_LIMIT_AUTH_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_AUTH_MAX=20               # 20 total requests to /api/auth/*

# Account Lockout Configuration
ACCOUNT_LOCKOUT_ENABLED=true
ACCOUNT_LOCKOUT_THRESHOLD=5          # Failed attempts before lockout
ACCOUNT_LOCKOUT_DURATION_SOFT=900    # 15 minutes (seconds)
ACCOUNT_LOCKOUT_DURATION_HARD=3600   # 1 hour (seconds)
ACCOUNT_LOCKOUT_DURATION_SEVERE=86400  # 24 hours (seconds)

# IP Reputation Configuration
IP_THROTTLE_THRESHOLD=10             # Failed logins before IP throttling
IP_BLOCK_THRESHOLD=20                # Failed logins before IP block
IP_BLACKLIST_THRESHOLD=50            # Failed logins before 24h blacklist

# IP Whitelist (comma-separated IPs that bypass rate limiting)
# Example: RATE_LIMIT_WHITELIST_IPS=127.0.0.1,192.168.1.100
RATE_LIMIT_WHITELIST_IPS=

# Graceful Degradation (if Redis unavailable, use in-memory store)
RATE_LIMIT_FALLBACK_MEMORY=true
