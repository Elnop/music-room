# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase Project ID (Required for type generation)
# Find it in your dashboard URL: https://supabase.com/dashboard/project/YOUR_PROJECT_ID
# Used by: npm run generate-types
# Note: You must login first with: npx supabase login
#       Get token from: https://supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_ID=your-project-id

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# ngrok Configuration (Required for Tunnel Mode)
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
# Sign up (free): https://dashboard.ngrok.com/signup
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# Tunnel Mode (Auto-configured - DO NOT SET MANUALLY)
# TUNNEL_URL is automatically set by start-with-tunnel.sh when running in tunnel mode
# Example: TUNNEL_URL=https://abc123.ngrok-free.app
# Leave empty for LAN mode

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# =====================================================
# Gmail SMTP Configuration (Email Verification)
# =====================================================

# Gmail credentials for sending verification emails
# IMPORTANT: Use App-Specific Password, NOT regular Gmail password
# Setup instructions:
#   1. Go to: https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already enabled
#   3. Navigate to: Security → 2-Step Verification → App passwords
#   4. Generate a new app password specifically for Zumik backend
#   5. Use the 16-character password below (remove spaces)
GMAIL_USER=noreply@yourdomain.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# Plain SMTP server used instead of Gmail when set (no TLS, no auth). Leave
# unset: with SUPABASE_MODE=local, make points it at the dev stack's Mailpit
# (emails shown on http://localhost:54424); GMAIL_USER stays the sender.
# SMTP_HOST=
# SMTP_PORT=54425

# Email Verification Settings
# false: accounts are created verified and signed in at once, no email is sent
# (development without Gmail credentials). true: a code is emailed; if it cannot
# be sent, registration answers 503 EMAIL_UNAVAILABLE and keeps no account.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_CODE_EXPIRY_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_RESENDS_PER_HOUR=3

# =====================================================
# Redis Configuration (Session Revocation, Rate Limiting & Brute Force Protection)
# Required: authentication fails closed (503) without Redis
# =====================================================

# Redis connection (Docker mode: "redis" | Local mode: "localhost")
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =====================================================
# Rate Limiting & Security Configuration
# =====================================================

# IMPORTANT: Rate limiting requires Redis in production
# Set to "false" in development to disable rate limiting (Redis stays required
# for session revocation)
# Production: MUST be "true" with Redis running
RATE_LIMIT_ENABLED=true

# Login Rate Limits
# 15 minutes
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# 5 attempts per window
RATE_LIMIT_LOGIN_MAX=5

# Registration Rate Limits
# 1 hour
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
# 3 registrations per hour per IP
RATE_LIMIT_REGISTER_MAX=3

# OAuth Rate Limits
# 15 minutes
RATE_LIMIT_OAUTH_WINDOW_MS=900000
# 10 attempts per provider
RATE_LIMIT_OAUTH_MAX=10

# Global Auth Rate Limits
# 15 minutes
RATE_LIMIT_AUTH_WINDOW_MS=900000
# 20 total requests to /api/auth/*
RATE_LIMIT_AUTH_MAX=20

# Failed access token verifications per IP (protected routes and socket handshake)
# Past the limit: 429 RATE_LIMIT_EXCEEDED / socket TOO_MANY_ATTEMPTS, without
# asking Supabase, until the window ends
# 15 minutes
RATE_LIMIT_TOKEN_WINDOW_MS=900000
# 20 failed verifications per window
RATE_LIMIT_TOKEN_MAX=20

# SoundCloud routes (/api/soundcloud/*), per signed-in user
# 1 minute
RATE_LIMIT_SOUNDCLOUD_WINDOW_MS=60000
# 120 requests per window
RATE_LIMIT_SOUNDCLOUD_MAX=120

# Profile photo upload and removal (/api/profile/avatar), per signed-in user
# 1 hour
RATE_LIMIT_AVATAR_WINDOW_MS=3600000
# 10 changes per window
RATE_LIMIT_AVATAR_MAX=10

# Account Lockout Configuration
# Set to "false" for development (disables brute force protection)
# Production: MUST be "true" with Redis running
ACCOUNT_LOCKOUT_ENABLED=true
# Failed attempts before lockout
ACCOUNT_LOCKOUT_THRESHOLD=5
# 15 minutes (seconds)
ACCOUNT_LOCKOUT_DURATION_SOFT=900
# 1 hour (seconds)
ACCOUNT_LOCKOUT_DURATION_HARD=3600
# 24 hours (seconds)
ACCOUNT_LOCKOUT_DURATION_SEVERE=86400

# IP Reputation Configuration
# Failed logins before IP throttling
IP_THROTTLE_THRESHOLD=10
# Failed logins before IP block
IP_BLOCK_THRESHOLD=20
# Failed logins before 24h blacklist
IP_BLACKLIST_THRESHOLD=50

# IP Whitelist (comma-separated IPs that bypass rate limiting)
# Example: RATE_LIMIT_WHITELIST_IPS=127.0.0.1,192.168.1.100
RATE_LIMIT_WHITELIST_IPS=

# Proxies trusted to set X-Forwarded-For (HTTP and Socket.io client IP).
# Empty (default): the connecting peer is the client, X-Forwarded-For is
# ignored. Otherwise Express `trust proxy` syntax: a hop count (1) or
# addresses, subnets and names (loopback, uniquelocal), comma-separated.
# Set it only when every request goes through that proxy, or clients can
# forge their IP. Example behind one reverse proxy: TRUST_PROXY=1
TRUST_PROXY=

# =====================================================
# Development vs Production Modes
# =====================================================
#
# Redis is ALWAYS required: logout writes revoked access tokens to a Redis
# denylist (session revocation) and every authenticated request checks it.
# Without a ready Redis, authenticated requests and logout answer
# 503 REVOCATION_UNAVAILABLE. `make dev-docker` starts Redis automatically;
# `make dev-local` starts it too; otherwise run `make redis-start`.
#
# DEVELOPMENT MODE (Redis still running):
#   RATE_LIMIT_ENABLED=false
#   ACCOUNT_LOCKOUT_ENABLED=false
#   → Rate limiting and brute force protection disabled
#   → Session revocation still active (needs Redis)
#   → Fast local iteration
#
# PRODUCTION MODE:
#   RATE_LIMIT_ENABLED=true
#   ACCOUNT_LOCKOUT_ENABLED=true
#   → All security protections active
#   → Use: make dev-docker (starts Redis automatically)
#
# Architecture decision: No in-memory fallback to avoid
# multi-instance security vulnerabilities in production.
# =====================================================
