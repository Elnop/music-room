{
  "path": [
    "src"
  ],
  "format": [
    "typescript"
  ],
  "minLines": 5,
  "minTokens": 50,
  "threshold": 0,
  "exitCode": 1,
  "reporters": [
    "console"
  ],
  "gitignore": true,
  "absolute": false,
  "ignore": [
    "**/*.test.ts",
    "**/src/test/**",
    "**/src/shared/types/supabase.generated.ts",
    "**/src/features/auth/auth.controller.ts",
    "**/src/features/auth/auth.openapi.ts",
    "**/src/features/auth/auth.service.ts",
    "**/src/features/auth/middleware/rate-limit.middleware.ts",
    "**/src/features/auth/services/user.service.ts",
    "**/src/features/auth/utils/auth.helpers.ts",
    "**/src/features/friends/friends.controller.ts",
    "**/src/features/friends/friends.openapi.ts",
    "**/src/features/music-control/music-control.controller.ts",
    "**/src/features/music-control/music-control.openapi.ts",
    "**/src/features/playlists/playlist.controller.ts",
    "**/src/features/playlists/playlist.openapi.ts",
    "**/src/features/playlists/playlist.service.ts",
    "**/src/features/profile/profile.controller.ts",
    "**/src/features/profile/profile.openapi.ts",
    "**/src/features/profile/services/music-preferences.service.ts",
    "**/src/features/profile/services/privacy.service.ts",
    "**/src/features/profile/services/profile.service.ts",
    "**/src/features/queue/queue.openapi.ts",
    "**/src/features/soundcloud/soundcloud.openapi.ts",
    "**/src/realtime/index.ts"
  ]
}
