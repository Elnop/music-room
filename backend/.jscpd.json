{
  "path": [
    "src"
  ],
  "format": [
    "typescript"
  ],
  "minLines": 5,
  "minTokens": 50,
  "threshold": 0,
  "exitCode": 1,
  "reporters": [
    "console"
  ],
  "gitignore": true,
  "absolute": false,
  "ignore": [
    "**/*.test.ts",
    "**/src/test/**",
    "**/src/shared/types/supabase.generated.ts",
    "**/src/features/auth/middleware/rate-limit.middleware.ts",
    "**/src/features/friends/friends.controller.ts",
    "**/src/features/music-control/music-control.controller.ts",
    "**/src/realtime/index.ts"
  ]
}
