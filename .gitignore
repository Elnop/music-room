# Dependencies
node_modules/
# Root has no package.json; only backend/ and mobile/ lockfiles are tracked
/package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment variables
.env
.env.local
.env.*.local

# Build output
dist/
build/
.gradle/

# Android signing keys
*.keystore
*.jks
# Shared debug key (public passwords), registered for Google Sign-In: see mobile/plugins/withDebugKeystore.js
!mobile/keystores/debug.keystore
mobile/android/gradle.properties
mobile/android/key.properties

# Logs
logs/
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
# Load tests: fixtures hold passwords and tokens; results are per run
tests/performance/fixtures/
tests/performance/results/*
!tests/performance/results/.gitkeep

# Misc
*.tsbuildinfo
# Claude Code: share team settings, keep personal config local
.claude/*
!.claude/settings.json

tmp/

# AI tooling (BMAD, superpowers): local only
_bmad/
_bmad-output/
.agents/skills/
skills-lock.json
docs/superpowers/
.superpowers/
