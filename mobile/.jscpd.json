{
	"path": ["src"],
	"format": ["typescript", "tsx"],
	"minLines": 5,
	"minTokens": 50,
	"threshold": 0,
	"exitCode": 1,
	"reporters": ["console"],
	"gitignore": true,
	"absolute": false,
	"ignore": [
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/__tests__/**",
		"**/__mocks__/**",
		"**/src/assets.d.ts",
		"**/src/shared/theme/components/Skeleton.tsx"
	]
}
