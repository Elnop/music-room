{
	"path": ["src"],
	"format": ["typescript", "tsx"],
	"minLines": 5,
	"minTokens": 50,
	"threshold": 0,
	"exitCode": 1,
	"reporters": ["console"],
	"gitignore": true,
	"absolute": false,
	"ignore": [
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/__tests__/**",
		"**/__mocks__/**",
		"**/src/assets.d.ts",
		"**/src/shared/components/ui/Skeleton.tsx",
		"**/src/components/profile/NowPlayingInline.tsx",
		"**/src/components/profile/ProfileSection.tsx",
		"**/src/components/profile/VisibilityToggle.tsx",
		"**/src/navigation/AuthNavigator.tsx",
		"**/src/navigation/stacks/FriendsStack.tsx",
		"**/src/navigation/stacks/PlaylistsStack.tsx",
		"**/src/navigation/stacks/ProfileStack.tsx",
		"**/src/navigation/stacks/SearchStack.tsx",
		"**/src/screens/profile/EditProfileScreen.tsx",
		"**/src/screens/profile/LinkedAccountsScreen.tsx",
		"**/src/screens/profile/MusicPreferencesScreen.tsx",
		"**/src/screens/profile/MyDevicesScreen.tsx",
		"**/src/screens/profile/PrivacySettingsScreen.tsx",
		"**/src/screens/profile/ProfileScreen.tsx",
		"**/src/screens/search/SoundCloudSearchScreen.tsx",
		"**/src/screens/search/components/SoundCloudTrackItem.tsx",
		"**/src/types/assets.d.ts"
	]
}
