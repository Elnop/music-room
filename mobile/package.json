{
	"name": "mobile",
	"version": "1.0.0",
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"start:lan": "expo start --lan",
		"start:tunnel": "expo start --tunnel",
		"start:clear": "expo start --clear",
		"start:lan-clear": "expo start --lan --clear",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "node ../tools/guardrails/run-checks.mjs type-check check:lint check:dead-code check:deps check:duplication check:semgrep check:ast-grep check:secrets test check:exceptions",
		"check:lint": "eslint . --quiet",
		"check:dead-code": "knip",
		"check:deps": "depcruise src App.tsx index.ts --config .dependency-cruiser.cjs --ignore-known --output-type err-long",
		"check:duplication": "jscpd",
		"check:semgrep": "node ../tools/guardrails/docker-scan.mjs semgrep mobile",
		"check:ast-grep": "ast-grep scan",
		"check:secrets": "node ../tools/guardrails/docker-scan.mjs secrets mobile",
		"check:exceptions": "node ../tools/guardrails/check-exceptions.mjs mobile",
		"format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
		"type-check": "tsc --noEmit",
		"test": "node --test eslint/plugin-components.test.mjs && jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"fix": "npm run format && npm run lint:fix",
		"check-all": "npm run type-check && npm run lint && npm run format",
		"clean": "rm -rf node_modules && rm -rf .expo && npm install",
		"clean:cache": "rm -rf .expo && rm -rf node_modules/.cache",
		"clean:full": "rm -rf node_modules && rm -rf .expo && rm -rf node_modules/.cache && npm install",
		"reset": "npm run clean:cache && npm start -- --clear",
		"doctor": "npx expo-doctor",
		"update": "npx expo install --check",
		"prebuild": "npx expo prebuild",
		"build:local": "npx expo run:android",
		"dev:backend": "cd ../backend && npm run dev",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@expo/config-plugins": "^54.0.4",
		"@expo/vector-icons": "^15.0.3",
		"@hookform/resolvers": "~5.2.2",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/slider": "5.0.1",
		"@react-native-google-signin/google-signin": "^16.1.1",
		"@react-navigation/bottom-tabs": "^7.9.0",
		"@react-navigation/native": "^7.1.26",
		"@react-navigation/native-stack": "^7.9.0",
		"@tanstack/react-query": "^5.104.5",
		"expo": "~54.0.25",
		"expo-asset": "~12.0.12",
		"expo-audio": "^1.1.0",
		"expo-build-properties": "~1.0.9",
		"expo-constants": "~18.0.14",
		"expo-device": "~8.0.10",
		"expo-font": "~14.0.12",
		"expo-haptics": "~15.0.8",
		"expo-image-manipulator": "~14.0.8",
		"expo-image-picker": "~17.0.11",
		"expo-linear-gradient": "~15.0.7",
		"expo-media-control": "2.1.0",
		"expo-network": "~8.0.8",
		"expo-status-bar": "~3.0.8",
		"expo-system-ui": "~6.0.9",
		"react": "19.1.0",
		"react-hook-form": "^7.69.0",
		"react-native": "0.81.5",
		"react-native-fbsdk-next": "^13.4.1",
		"react-native-gesture-handler": "~2.28.0",
		"react-native-get-random-values": "~1.11.0",
		"react-native-image-colors": "^2.5.1",
		"react-native-reanimated": "~4.1.1",
		"react-native-reorderable-list": "^0.18.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-toast-message": "^2.3.3",
		"react-native-web": "^0.21.0",
		"react-native-worklets": "0.5.1",
		"socket.io-client": "^4.8.3",
		"uuid": "^13.0.0",
		"zod": "^4.6.5",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.51.0",
		"@eslint/js": "^9.39.2",
		"@expo/ngrok": "^4.1.3",
		"@testing-library/react-native": "^13.3.3",
		"@types/jest": "29.5.14",
		"@types/node": "^24.10.1",
		"@types/react": "~19.1.0",
		"babel-plugin-module-resolver": "^5.0.2",
		"babel-preset-expo": "^54.0.7",
		"dependency-cruiser": "^18.7.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^16.5.0",
		"jest": "~29.7.0",
		"jest-expo": "~54.0.18",
		"jscpd": "^5.4.2",
		"knip": "^5.88.1",
		"patch-package": "^8.0.1",
		"prettier": "^3.6.2",
		"react-test-renderer": "19.1.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.50.1"
	},
	"overrides": {
		"@expo/ngrok": {
			"uuid": "^10.0.0"
		},
		"glob": "^10.3.10",
		"rimraf": "^5.0.5",
		"inflight": "npm:@zkochan/inflight@^2.0.0",
		"test-exclude": "^7.0.2"
	},
	"jest": {
		"preset": "jest-expo",
		"collectCoverageFrom": [
			"src/**/*.{ts,tsx}",
			"App.tsx",
			"!src/**/*.test.{ts,tsx}",
			"!src/**/*.d.ts"
		]
	},
	"private": true
}
