{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --clear",
    "start:lan-clear": "expo start --lan --clear",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "fix": "npm run format && npm run lint:fix",
    "check-all": "npm run type-check && npm run lint && npm run format",
    "clean": "rm -rf node_modules && rm -rf .expo && npm install",
    "clean:cache": "rm -rf .expo && rm -rf node_modules/.cache",
    "clean:full": "rm -rf node_modules && rm -rf .expo && rm -rf node_modules/.cache && npm install",
    "reset": "npm run clean:cache && npm start -- --clear",
    "doctor": "npx expo-doctor",
    "update": "npx expo install --check",
    "prebuild": "npx expo prebuild",
    "build:local": "npx expo run:android",
    "dev:backend": "cd ../backend && npm run dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@supabase/supabase-js": "^2.89.0",
    "@types/lodash": "^4.17.21",
    "axios": "^1.13.2",
    "expo": "~54.0.25",
    "expo-asset": "~12.0.12",
    "expo-audio": "^1.1.0",
    "expo-build-properties": "~1.0.9",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.11",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.3",
    "lodash": "^4.17.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.69.0",
    "react-native": "0.81.5",
    "react-native-fbsdk-next": "^13.4.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^24.10.1",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.50.1"
  },
  "private": true
}
