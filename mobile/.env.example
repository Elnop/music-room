# Backend API (Backend: http://localhost:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# Supabase Configuration (Backend uses @supabase/supabase-js@2.50.0+)
# OPTIONNEL POUR L'INSTANT - Peut être configuré plus tard
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Spotify Configuration (Phase ultérieure - Backend Phase 6)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# EAS Configuration (Required for Tunnel Mode)
# Used by setup-eas-auto.sh for automatic, non-interactive authentication
# Create a Personal Access Token at: https://expo.dev/settings/access-tokens
EXPO_TOKEN=your-expo-token-here