# Backend API Configuration
#
# LAN MODE (default):
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
#
# For physical devices on same WiFi, replace localhost with your local IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# EXPO_PUBLIC_WS_URL=ws://192.168.1.100:3000
#
# TUNNEL MODE:
# DO NOT set these manually! Tunnel mode auto-configures these values.
# Just run: make dev-tunnel

# Supabase Configuration (Backend uses @supabase/supabase-js@2.50.0+)
# OPTIONNEL POUR L'INSTANT - Peut être configuré plus tard
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS Configuration (Required for Tunnel Mode)
# Used by setup-eas-auto.sh for automatic, non-interactive authentication
# Create a Personal Access Token at: https://expo.dev/settings/access-tokens
EXPO_TOKEN=your-expo-token-here

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id

# Facebook OAuth Configuration
# Get these from Facebook Developer Console: https://developers.facebook.com/apps/
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your-facebook-client-token